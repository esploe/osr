# Copy this file to .env and fill in what you need.

# Optional: enables "render from score URL" (fetches the .osr via the
# official osu! API instead of you uploading it manually).
# Create an OAuth client at https://osu.ppy.sh/home/account/edit#oauth
# (any callback URL works, this app only uses the client_credentials flow).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# How many renders to run at once. Software (CPU) rendering is heavy --
# leave this at 1 unless you know your box can take more concurrent renders.
RENDER_CONCURRENCY=1

# Optional: auto-upload finished renders to a self-hosted Zipline instance
# and show the resulting share link on the frontend. Get a token from your
# Zipline instance's dashboard under Account/Settings -> API Tokens (this
# is NOT your login password).
ZIPLINE_URL=
ZIPLINE_TOKEN=

# Optional: only needed if ZIPLINE_URL is a LAN IP (e.g. to bypass a
# reverse proxy's upload size cap) rather than your public Zipline domain.
# Zipline returns share links built from whichever host the upload hit, so
# without this the link shown to users would be an unreachable LAN IP link.
# Set it to your real public Zipline URL (e.g. https://your-zipline-domain)
# and share links will point there regardless of what ZIPLINE_URL is.
ZIPLINE_PUBLIC_URL=

# --- Remote GPU render worker (optional) -----------------------------------
# By default rendering happens locally (software OpenGL). To offload it to
# a worker agent running on a separate machine with a real GPU:
#
# On the COORDINATOR (this machine, the one running docker-compose.yml):
#   RENDER_MODE=worker
#   WORKER_TOKEN=<any long random string -- shared secret with the worker>
#
# On the WORKER (the GPU machine, running docker-compose.worker.yml):
#   WORKER_TOKEN=<same value as above>
#   COORDINATOR_URL=http://<this machine's LAN IP>:8080
#
# COORDINATOR_URL below is also what the Discord bot uses to reach the
# coordinator (see "Discord bot" section further down) -- if the worker and
# the bot run on the same machine, one value covers both.
#
# Leave RENDER_MODE unset/"local" (the default) if you're not using a
# separate worker -- nothing below this line is needed in that case.
RENDER_MODE=local
WORKER_TOKEN=
COORDINATOR_URL=

# Worker-only, optional: the DRI render node VAAPI hardware encoding
# ("H.264 hardware (VAAPI)" in the output options) should use. Defaults to
# /dev/dri/renderD128, which is right for a single-GPU box -- only change
# this if `ls /dev/dri` on the worker shows a different render node.
VAAPI_DEVICE=/dev/dri/renderD128

# Worker-only, optional, unverified live (see docker/worker-entrypoint.sh):
# "xorg" runs danser against a real Xorg server on the GPU's actual display
# output instead of Xvfb+VirtualGL, skipping VirtualGL's per-frame
# GPU->Xvfb copy entirely. Needs a connector forced "connected" at the
# kernel level first (a video=<connector>:D boot param on the worker VM).
# Leave unset/"xvfb-vgl" (the default) for the proven Xvfb+VirtualGL path.
WORKER_DISPLAY_MODE=xvfb-vgl

# --- Discord bot (optional) -------------------------------------------------
# Runs as its own container via a separate compose file, docker-compose.bot.yml
# -- same pattern as the remote GPU worker above: its own machine (or the
# coordinator's own machine, pointing COORDINATOR_URL at localhost), its own
# `docker compose -f docker-compose.bot.yml up --build -d`, NOT started by a
# plain `docker compose up`. Posts rendered videos into a Discord channel via
# two triggers:
#   - Reply to a bathbot/owo score message and @mention this bot in your
#     reply -> renders the score shown in that message.
#   - @mention this bot directly (no reply, or replying to something that
#     isn't a recognized score bot) -> renders the pinging user's own most
#     recent osu!standard score. Requires that user to have run
#     /link <osu username> in Discord first.
# The bathbot/owo message parsing is heuristic/best-effort (see
# bot/src/scoreParser.js) -- it was not tested against live bathbot/owo
# output. If it misfires, set SCORE_BOT_IDS below and/or adjust the parser.
#
# Setup:
#   1. Create an application at https://discord.com/developers/applications
#   2. Bot tab: create a bot user, copy its token -> DISCORD_BOT_TOKEN.
#      Also enable "Message Content Intent" on this tab -- required to read
#      message text/replies/mentions, the bot won't see any messages
#      without it.
#   3. General Information tab: copy the Application ID -> DISCORD_CLIENT_ID.
#   4. Installation tab (or OAuth2 tab -> URL Generator on older portals):
#      check "bot" and "applications.commands" scopes, and at minimum "Send
#      Messages"/"Read Message History"/"View Channels" bot permissions.
#      Open the generated install link to invite it to your server.
# Also requires COORDINATOR_URL (above, e.g. http://<coordinator LAN IP>:8080
# -- no default, the bot fails to start without it), OSU_CLIENT_ID/
# OSU_CLIENT_SECRET (above) for score lookups, and ZIPLINE_URL/ZIPLINE_TOKEN
# (above) -- without Zipline configured the bot has no shareable link to post
# once a render finishes.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# Optional: register the bot's slash commands (/link, /unlink) to a single
# guild for instant availability. Leave unset to register them globally
# instead (works in every server the bot is in, but can take up to an hour
# to show up after the bot's first start).
DISCORD_GUILD_ID=

# Optional: comma-separated Discord user IDs of the score bot(s) (e.g.
# Bathbot, OwO) whose messages should be treated as "reply to render this
# score". Leave unset to fall back to a loose match on "bathbot"/"owo" in
# the replied-to message's bot username -- set this explicitly if that
# fallback misfires or you use a differently-named/self-hosted score bot.
SCORE_BOT_IDS=

# Optional: name of a saved render profile (Profiles tab in the web UI) for
# the bot to use instead of the default settings -- useful for keeping
# Discord renders quick/small (e.g. 720p60) regardless of the web UI's
# defaults. Leave unset to use the same defaults a first-time web UI visit
# would.
BOT_RENDER_PROFILE=
