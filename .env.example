# Copy this file to .env and fill in what you need.

# Optional: enables "render from score URL" (fetches the .osr via the
# official osu! API instead of you uploading it manually).
# Create an OAuth client at https://osu.ppy.sh/home/account/edit#oauth
# (any callback URL works, this app only uses the client_credentials flow).
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# How many renders to run at once. Software (CPU) rendering is heavy --
# leave this at 1 unless you know your box can take more concurrent renders.
RENDER_CONCURRENCY=1

# Optional: auto-upload finished renders to a self-hosted Zipline instance
# and show the resulting share link on the frontend. Get a token from your
# Zipline instance's dashboard under Account/Settings -> API Tokens (this
# is NOT your login password).
ZIPLINE_URL=
ZIPLINE_TOKEN=

# --- Remote GPU render worker (optional) -----------------------------------
# By default rendering happens locally (software OpenGL). To offload it to
# a worker agent running on a separate machine with a real GPU:
#
# On the COORDINATOR (this machine, the one running docker-compose.yml):
#   RENDER_MODE=worker
#   WORKER_TOKEN=<any long random string -- shared secret with the worker>
#
# On the WORKER (the GPU machine, running docker-compose.worker.yml):
#   WORKER_TOKEN=<same value as above>
#   COORDINATOR_URL=http://<this machine's LAN IP>:8080
#
# Leave RENDER_MODE unset/"local" (the default) if you're not using a
# separate worker -- nothing below this line is needed in that case.
RENDER_MODE=local
WORKER_TOKEN=
COORDINATOR_URL=

# Worker-only, optional: the DRI render node VAAPI hardware encoding
# ("H.264 hardware (VAAPI)" in the output options) should use. Defaults to
# /dev/dri/renderD128, which is right for a single-GPU box -- only change
# this if `ls /dev/dri` on the worker shows a different render node.
VAAPI_DEVICE=/dev/dri/renderD128
