+// osr split-encode patch: when split-encode ran, each chunk wrote its own
+// self-contained file (chunk_0000.<ext>, chunk_0001.<ext>, ...) alternating
+// between the two encoder lanes instead of the single video.<ext> combine()
+// below expects. Concatenate them in index order via the concat demuxer +
+// stream copy (no re-encode -- validated live that x264 and VAAPI segments
+// of the same resolution/fps/pixel format concatenate and decode cleanly)
+// into video.<ext> so combine() needs no further changes. No-op when
+// split-encode wasn't used. splitChunks is populated in index order by
+// newChunk (chunk 0 first), so ranging it yields the correct global order.
+func concatSplitVideo() {
+	if !splitActive || len(splitChunks) == 0 {
+		return
+	}
+
+	tempDir := filepath.Join(settings.Recording.GetOutputDir(), output+"_temp")
+
+	listPath := filepath.Join(tempDir, "concat_list.txt")
+	var sb strings.Builder
+	for _, c := range splitChunks {
+		// concat demuxer resolves relative paths against the list file's own
+		// directory, so the bare filename (same dir) is correct here.
+		sb.WriteString(fmt.Sprintf("file '%s'\n", c.outputName))
+	}
+
+	if err := os.WriteFile(listPath, []byte(sb.String()), 0644); err != nil {
+		panic(fmt.Sprintf("split-encode: failed to write concat list: %s", err))
+	}
+
+	options := []string{
+		"-y",
+		"-f", "concat",
+		"-safe", "0",
+		"-i", listPath,
+		"-c", "copy",
+		filepath.Join(tempDir, "video."+settings.Recording.Container),
+	}
+
+	log.Println(fmt.Sprintf("split-encode: concatenating %d chunk segments...", len(splitChunks)))
+
+	cmd := exec.Command(ffmpegExec, options...)
+
+	if settings.Recording.ShowFFmpegLogs {
+		cmd.Stdout = os.Stdout
+		cmd.Stderr = os.Stderr
+	}
+
+	if err := cmd.Run(); err != nil {
+		panic(fmt.Sprintf("split-encode: failed to concatenate %d chunk segments: %s", len(splitChunks), err))
+	}
+
+	log.Println("split-encode: segments concatenated successfully.")
+}
